{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ai-central",
  "version": "0.6.0",
  "identifier": "com.aicentral.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src epub: http://epub.localhost; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src epub: http://epub.localhost; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "app", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/gnome-shell/extensions/ai-central-popup@local/extension.js": "../gnome-shell-extension/ai-central-popup@local/extension.js",
          "/usr/share/gnome-shell/extensions/ai-central-popup@local/metadata.json": "../gnome-shell-extension/ai-central-popup@local/metadata.json",
          "/usr/share/gnome-shell/extensions/ai-central-popup@local/trayLinux.png": "icons/trayLinux.png",
          "/usr/share/cinnamon/extensions/ai-central-popup@local/extension.js": "../cinnamon-extension/ai-central-popup@local/extension.js",
          "/usr/share/cinnamon/extensions/ai-central-popup@local/metadata.json": "../cinnamon-extension/ai-central-popup@local/metadata.json",
          "/usr/share/kwin/scripts/ai-central-popup/metadata.json": "../kwin-script/ai-central-popup/metadata.json",
          "/usr/share/kwin/scripts/ai-central-popup/contents/code/main.js": "../kwin-script/ai-central-popup/contents/code/main.js"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/gnome-shell/extensions/ai-central-popup@local/extension.js": "../gnome-shell-extension/ai-central-popup@local/extension.js",
          "/usr/share/gnome-shell/extensions/ai-central-popup@local/metadata.json": "../gnome-shell-extension/ai-central-popup@local/metadata.json",
          "/usr/share/gnome-shell/extensions/ai-central-popup@local/trayLinux.png": "icons/trayLinux.png",
          "/usr/share/cinnamon/extensions/ai-central-popup@local/extension.js": "../cinnamon-extension/ai-central-popup@local/extension.js",
          "/usr/share/cinnamon/extensions/ai-central-popup@local/metadata.json": "../cinnamon-extension/ai-central-popup@local/metadata.json",
          "/usr/share/kwin/scripts/ai-central-popup/metadata.json": "../kwin-script/ai-central-popup/metadata.json",
          "/usr/share/kwin/scripts/ai-central-popup/contents/code/main.js": "../kwin-script/ai-central-popup/contents/code/main.js"
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
