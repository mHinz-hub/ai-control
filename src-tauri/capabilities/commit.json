{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "commit",
  "description": "Commit-Fenster: Git-Zustand, Diffs, Commit und Push — keine PTY, keine Verwaltung.",
  "windows": [
    "commit-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-resize-dragging",
    "clipboard-manager:allow-write-text",
    "allow-list-projects",
    "allow-buffer-read",
    "allow-term-log",
    "allow-git-repos",
    "allow-git-diff",
    "allow-git-push-check",
    "allow-git-commit",
    "allow-window-buttons-left"
  ]
}
